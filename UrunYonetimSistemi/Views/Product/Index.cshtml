@model List<UrunYonetimSistemi.Models.Product>

<h2>Ürün Listesi</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Yeni Ürün Ekle</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Adı</th>
            <th>Fiyat</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var urun in Model)
        {
            <tr>
                <td>@urun.Name</td>
                <td>@urun.Price ₺</td>
                <td>@urun.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@urun.Id" class="btn btn-info btn-sm">Detay</a>
                    <a asp-action="Edit" asp-route-id="@urun.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@urun.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
